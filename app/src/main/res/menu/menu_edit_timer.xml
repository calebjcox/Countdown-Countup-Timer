<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!--
      Checkable, and the check is the whole state: it is a view setting rather than an
      action, so the menu has to say which way it is currently set. The activity reads it
      back from storage every time the menu is built.
    -->
    <item
        android:id="@+id/action_show_hints"
        android:checkable="true"
        android:title="@string/show_hints"
        app:showAsAction="never" />
    <!--
      Hidden rather than absent on a timer that has not been saved yet — this menu is now
      inflated either way, because the item above belongs on both. See setUpToolbar.
    -->
    <item
        android:id="@+id/action_delete"
        android:title="@string/delete"
        app:showAsAction="never" />
</menu>
