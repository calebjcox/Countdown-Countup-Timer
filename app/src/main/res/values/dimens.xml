<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches whatever corner radius the launcher uses for widget backgrounds. -->
    <dimen name="widget_corner_radius">@android:dimen/system_app_widget_background_radius</dimen>

    <!--
      Starting points, not the sizes a widget actually renders at. WidgetRenderer scales
      padding and both label sizes to the cell it is building for and overrides all
      three on every variant, because the right figure for a one-row cell and the right
      figure for a four-row one are not the same figure. These are what the layouts show
      before that happens: the initialLayout the launcher draws for the frame before the
      first update, and the layouts as they render in a preview tool.
    -->
    <dimen name="widget_padding">8dp</dimen>
    <dimen name="widget_name_text">12sp</dimen>
    <dimen name="widget_footer_text">12sp</dimen>

    <dimen name="screen_margin">16dp</dimen>
    <dimen name="section_spacing">20dp</dimen>
</resources>
