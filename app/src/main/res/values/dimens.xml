<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches whatever corner radius the launcher uses for widget backgrounds. -->
    <dimen name="widget_corner_radius">@android:dimen/system_app_widget_background_radius</dimen>

    <!--
      Two sets of widget metrics, one per density band in WidgetRenderer. The roomy set
      is what the layouts declare, so a widget rendered straight from XML — the
      initialLayout, or the picker's own inflation — looks like the large variant;
      WidgetRenderer overrides both sets explicitly on every variant it builds.

      They are dimens rather than literals in either place because both sides need the
      same numbers: styles.xml to declare the default, WidgetRenderer to switch between
      them. A number written twice is a number that ends up meaning two things.

      The compact set is what makes three rows fit a one-row cell. At 6dp of padding a
      68dp cell has 56dp inside it, and two 10sp labels leave 32dp for the value — which
      is the whole reason the "until" line is reachable at 2x1 now.
    -->
    <dimen name="widget_padding">10dp</dimen>
    <dimen name="widget_padding_compact">6dp</dimen>
    <dimen name="widget_name_text">12sp</dimen>
    <dimen name="widget_name_text_compact">10sp</dimen>
    <dimen name="widget_footer_text">11sp</dimen>
    <dimen name="widget_footer_text_compact">10sp</dimen>

    <!--
      A floor, not a fixed size. The four above are what fits a cell with a number
      filling it; where the number does not need the room, WidgetRenderer grows the
      labels a point at a time towards this, which is roughly where a caption stops
      getting easier to read and starts competing with what it captions.
    -->
    <dimen name="widget_label_text_max">17sp</dimen>

    <!--
      The value's box, and the range its auto-sizing searches inside it.

      The two text sizes are read from both sides for the same reason as the metrics
      above: styles.xml hands them to `autoSizeM(in|ax)TextSize`, and WidgetRenderer
      turns them into the line heights that bound the box.

      The height is only the default the layouts declare — every variant the renderer
      builds sets its own, measured against the cell it is for. 56dp is what a 44sp
      line needs, so the default is the largest box that can ever be useful.
    -->
    <dimen name="widget_value_height">56dp</dimen>
    <dimen name="widget_value_text_min">11sp</dimen>
    <dimen name="widget_value_text_max">44sp</dimen>

    <dimen name="screen_margin">16dp</dimen>
    <dimen name="section_spacing">20dp</dimen>
</resources>
