<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget colors come from the device's Material You palette, which exists as
  framework resources from API 31. Referencing them directly means the widget
  follows the wallpaper without the app shipping a palette of its own, and without
  any runtime code to resolve them.
-->
<resources>
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text_primary">@android:color/system_accent1_600</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>

    <color name="ic_launcher_background">@android:color/system_accent1_100</color>
</resources>
