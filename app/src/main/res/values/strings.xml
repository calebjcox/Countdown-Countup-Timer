    <string name="import_too_new">That backup was made by a newer version of Countdowns</string>
    <string name="import_empty">There are no timers in that file</string>

    <string name="import_body">Merge keeps the timers already on this phone and updates any the backup also has. Replace makes the backup the whole list.</string>
