    <!-- Backup -->
    <string name="backup_title">Backup</string>
    <string name="auto_backup_section">Automatic backup</string>
    <string name="auto_backup_body">Your timers are included in your phone\'s Google backup, so they come back on their own when you reinstall Countdowns or set up a new phone. This only happens if backup is turned on in your phone\'s settings, it runs on Android\'s own schedule, and it can\'t be started from here — so if your timers matter to you, keep a file as well.</string>
    <string name="backup_file_section">Backup file</string>
    <string name="backup_file_body">Save your timers to a file you keep. You choose where it goes and Countdowns needs no extra permissions to write it. The file holds the timers themselves, not where their widgets sit on your home screen.</string>
    <string name="export_timers">Export timers</string>
