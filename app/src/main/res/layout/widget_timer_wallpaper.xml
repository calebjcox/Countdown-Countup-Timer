<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget drawn straight onto the wallpaper: no background, and a shadow behind
  every line so the text survives a busy photo.

  The shadow is the whole reason this is a second file — RemoteViews cannot call
  setShadowLayer — and so Backdrop.NONE is the only thing that reaches it. A photo can
  be bright at one end of a line of text and dark at the other, which no single colour
  survives on its own; the other two backdrops put a surface of this app's own under the
  text instead and want no shadow at all.

  Identical to widget_timer.xml in structure and view ids, so WidgetRenderer stays
  one code path and only swaps the layout resource. The colours here are
  placeholders — WidgetPalette resolves the real ones at draw time from the
  wallpaper's own hint, which is a different question from the system theme and
  therefore cannot be answered by a -night qualifier.

  The root is @android:id/background, which matters most on this layout: with
  nothing here drawing a background, that id is the only thing telling the launcher
  which view its rounded corners belong to. See widget_timer.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/widget_name"
        style="@style/WidgetName.OnWallpaper"
        android:textColor="@color/widget_on_wallpaper_light_secondary" />

    <TextView
        android:id="@+id/widget_value"
        style="@style/WidgetValue.OnWallpaper"
        android:textColor="@color/widget_on_wallpaper_light_primary" />

    <Chronometer
        android:id="@+id/widget_ticker"
        style="@style/WidgetValue.Ticking.OnWallpaper"
        android:textColor="@color/widget_on_wallpaper_light_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_footer"
        style="@style/WidgetFooter.OnWallpaper"
        android:textColor="@color/widget_on_wallpaper_light_secondary" />
</LinearLayout>
