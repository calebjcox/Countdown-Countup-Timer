<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown in the launcher's widget picker. Static sample content, never inflated at
  runtime.

  The sizes are literals rather than the shared dimens because they are not the
  defaults — they are what WidgetRenderer computes for the band a 2x1 cell lands in,
  which is what the picker frames this at. A preview drawn at any other size is a
  promise the dropped widget does not keep, which is exactly what it used to be:
  three rows at sizes that then rendered as a bare number.

  Rows tight together with the space at the edges, for the same reason the real
  layout does it — see WidgetRenderer.metrics.

  A background even though timers default to showBackground = false: the picker draws
  previews on its own surface, not on the wallpaper, so the transparent variant has
  nothing to stand out against there.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/preview_name"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/preview_value"
        android:textColor="@color/widget_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/preview_footer"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
