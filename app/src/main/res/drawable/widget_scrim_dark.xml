<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark scrim, drawn behind text of the light tone. Same corner radius as
  widget_background.xml: a launcher rounds @android:id/background itself, and a shape
  that disagrees with it shows as a sliver at each corner.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <solid android:color="@color/widget_scrim_dark" />
</shape>
