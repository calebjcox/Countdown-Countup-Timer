<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission this app declares. It is protection level "normal": granted
      at install with no prompt and no runtime request. Alarms do not survive a
      reboot, so without this a widget could sit stale until the system's periodic
      update fired. Everything else the app does — drawing widgets, scheduling
      inexact alarms, storing timers — needs no permission at all.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CountdownWidgets">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditTimerActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!--
          Launched by the launcher when a widget is dropped, and again for
          "reconfigure" from the widget's long-press menu.
        -->
        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TimerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!--
              Every action here is exempt from the implicit-broadcast restrictions,
              so a manifest receiver still gets them. ACTION_DATE_CHANGED is not
              exempt and is deliberately absent: the midnight rollover is driven by
              this app's own alarm instead.
            -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.calebjcox.countdownwidgets.action.TICK" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>
    </application>
</manifest>
